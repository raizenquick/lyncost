{
  "name": "lyncost",
  "version": "0.1.5",
  "description": "Lyncost — Offline, private personal money and investment manager for Linux",
  "author": "raizenquick <raizenquick@users.noreply.github.com>",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "npm run build && tauri build --no-bundle",
    "dist": "bash packaging/build_packages.sh",
    "install:local": "npm run release && cp -f src-tauri/target/release/lyncost ~/.local/bin/lyncost.tmp && mv -f ~/.local/bin/lyncost.tmp ~/.local/bin/lyncost"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
